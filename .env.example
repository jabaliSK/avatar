# Copy to .env and adjust. Every service is pinned to ONE physical GPU.
# List them with: nvidia-smi --query-gpu=index,pci.bus_id --format=csv
# On this host the stack runs on GPU 1: GPU 0 stopped accepting compute on 2026-11-26 (docs/RUNBOOK.md, "GPU placement").
GPU_ID=1
# PCI bus id of the GPU above; scripts/gpu_guard.sh refuses to run if they diverge.
GPU_PCI_BUS=00000000:04:00.0

# Host ports (checked free at scaffold time; 22/53/5432/6333/8001/8060/8061/8888/9000+/11434/19530/27017 are taken).
LLM_PORT=18100
GATEWAY_PORT=8282
# Bind address for published ports. 127.0.0.1 = local only. The LLM and renderer ports have no login: leave them here.
BIND_ADDR=127.0.0.1
# Bind address of the gateway web UI and the TURN relay alone (default: BIND_ADDR). Set this host's LAN IP to serve other machines.
GATEWAY_BIND_ADDR=

# LLM (served by vLLM, FP8, Apache-2.0). The weights are ${MODELS_DIR}/qwen3-8b-fp8 (scripts/fetch_models.py downloads them).
LLM_SERVED_NAME=qwen3-8b
# Fraction of the GPU's memory vLLM may claim (weights 8.8 GiB + KV cache). Leaves room for ASR/TTS/head.
LLM_GPU_MEM_UTIL=0.22
LLM_MAX_MODEL_LEN=8192

# Paths on the host
MODELS_DIR=./models
AVATARS_DIR=./avatars
IMAGES_DIR=./images
# Stage A output (body / gesture loops, one folder per avatar) and the input of `onboard --loop`
LOOPS_DIR=./loops
# The Studio's data: uploaded photos (uploads/<avatar>/) and the state of avatar-creation jobs (jobs/). Created on first use.
STUDIO_DIR=./studio

# Renderer (live head + compositor, WebSocket API on RENDERER_PORT)
RENDERER_PORT=18110
# Avatar loaded at boot (one avatar is kept in memory; loading another takes ~9 s). Comma-separated names or "all".
RENDERER_PRELOAD=
RENDERER_OVERLAP=70
RENDERER_STEPS=10

# Gateway (OpenAvatarChat web UI + WebRTC)
# Default avatar for new sessions (an avatars/<name> folder). Switch at runtime by writing a name into ./run/avatar.
GATEWAY_AVATAR=
# 1 = serve HTTPS with a self-signed certificate (needed to use the microphone from any host name other than localhost).
GATEWAY_TLS=0
GATEWAY_TLS_CN=localhost
GATEWAY_TLS_SAN=
# H.264 video bitrate the WebRTC encoder may use (kbit/s).
GATEWAY_H264_KBPS=4000
GATEWAY_H264_MAX_KBPS=8000
# One session at a time. 1: a browser reconnecting from the same address (reload, flaky network) replaces its own stale session at once.
# 0: strict, it is refused until the old session has timed out (about 30 s). Another machine is refused while a session is live either way.
GATEWAY_RECONNECT_TAKEOVER=1
# Avatar Studio (the web page at /): anyone who can open it can talk to the avatars. Creating, changing and deleting avatars is open too
# unless a key is set here; the Studio then asks for it once per browser tab. Letters, digits and . _ ~ - only. Empty = no key.
STUDIO_KEY=

# Other machines: WebRTC media needs a TURN relay (coturn, compose profile "network"), because the gateway's own address is private to
# this host. Set GATEWAY_BIND_ADDR and TURN_HOST to this host's LAN IP, GATEWAY_TLS=1 (CN/SAN = that IP) and COMPOSE_PROFILES=network.
# TURN_USER/TURN_PASSWORD: letters, digits and . _ ~ - only. Every browser that loads the page is given them, so they limit the relay
# to people who can reach the page; they are not a login.
COMPOSE_PROFILES=
TURN_HOST=
TURN_USER=kka
TURN_PASSWORD=
