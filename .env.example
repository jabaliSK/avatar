# Copy to .env. Secrets stay server-side; never enter them in the browser.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
CUDA_VISIBLE_DEVICES=1
# flashhead: full-face/head animation; musetalk: original mouth-only renderer.
AVATAR_RENDERER=flashhead
# true: persistent Lite GPU worker and live text replies; false: batch Pro rendering.
LIVE_STREAMING=true
FLASHHEAD_PYTHON=./.venv-flashhead/bin/python
# Empty base URL selects the built-in local provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-tiny.en
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
SYSTEM_PROMPT=You are a friendly conversational assistant. Reply naturally in one or two short sentences. Do not use markdown.
PROVIDER_TIMEOUT=180
RENDER_TIMEOUT=600
